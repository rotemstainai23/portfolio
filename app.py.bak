}

AGENT_ORDER = ['analyst', 'devils', 'ceo', 'executor', 'ic']
AGENT_LABELS = {
    'analyst':  'Analyst',
    'devils':   'Devil\'s Advocate',
    'ceo':      'CEO',
    'executor': 'Executor',
    'ic':       'Investment Committee',
