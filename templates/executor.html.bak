<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Executor</title>
<link rel="stylesheet" href="_shared.css">
<style>
.servernote{background:rgba(77,166,255,.07);border:1px solid rgba(77,166,255,.25);border-radius:8px;padding:11px 15px;font-size:11.5px;color:var(--muted2);line-height:1.65;margin-bottom:14px}
.servernote b{color:var(--blue)}
.indstrip{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:14px}
.indchip{background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:10px 12px}
.indchip .ic-l{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px}
.indchip .ic-v{font-size:15px;font-weight:800}
.indchip .ic-s{font-size:10px;color:var(--muted);margin-top:3px}
.tftabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.tftab{padding:8px 15px;background:var(--surface);border:1px solid var(--border2);border-radius:8px;font-size:12.5px;color:var(--muted2);cursor:pointer;font-weight:600;font-family:inherit}
.tftab:hover{color:var(--text);border-color:var(--orange)}
.tftab.active{background:rgba(240,160,80,.14);color:var(--orange);border-color:var(--orange)}
.toggrow{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:12px;align-items:center}
.toggroup{display:flex;gap:5px;flex-wrap:wrap;align-items:center;background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:7px 9px}
.toggroup .gl{font-size:10px;color:var(--muted);margin-left:4px;font-weight:700}
.tg{padding:5px 10px;border-radius:7px;font-size:11px;cursor:pointer;font-family:inherit;font-weight:600;border:1px solid var(--border2);background:var(--bg);color:var(--muted);display:flex;align-items:center;gap:5px}
.tg:hover{color:var(--text)}.tg.on{color:#07090f}
.tg .dotc{width:9px;height:9px;border-radius:2px;display:inline-block}
.tg.on.c-ma20{background:var(--blue)}.tg.on.c-ma50{background:var(--orange)}
.tg.on.c-ma100{background:var(--purple)}.tg.on.c-ma200{background:var(--gold)}
.tg.on.c-vol{background:var(--muted2)}.tg.on.c-rsi{background:var(--purple)}
.tg.on.c-e{background:var(--yellow)}.tg.on.c-eg{background:var(--green)}
.tg.on.c-stop{background:var(--red)}.tg.on.c-tp{background:var(--blue)}.tg.on.c-sr{background:var(--muted2)}
.chartbox{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px;position:relative}
#chartCanvas{width:100%;height:520px;display:block}
.chart-status{position:absolute;inset:14px;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--muted);background:var(--surface);border-radius:8px;text-align:center;padding:24px;line-height:1.8}
.chart-status.hidden{display:none}
.chartmeta{font-size:11px;color:var(--muted);margin-top:8px;text-align:center}
.ftiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(232px,1fr));gap:13px}
.ftile{background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:15px;border-top:3px solid var(--green)}
.ftile.warn{border-top-color:var(--yellow)}
.ft-head{display:flex;align-items:center;gap:9px;margin-bottom:10px}
.ft-ico{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;background:rgba(46,204,113,.13)}
.ftile.warn .ft-ico{background:rgba(245,200,66,.14)}
.ft-name{font-size:13px;font-weight:700;flex:1}
.ft-badge{font-size:9.5px;font-weight:800;padding:3px 9px;border-radius:9px;background:rgba(46,204,113,.14);color:var(--green)}
.ftile.warn .ft-badge{background:rgba(245,200,66,.14);color:var(--yellow)}
.ft-val{font-size:16px;font-weight:800;margin-bottom:3px}
.ft-detail{font-size:11px;color:var(--muted2);line-height:1.55}
.rrbox{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px}
.rrrow{margin-bottom:15px}.rrrow:last-child{margin-bottom:0}
.rr-lbl{display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px}
.rr-lbl .v{font-weight:800}
.rr-track{height:24px;background:var(--bg);border-radius:6px;overflow:hidden}
.rr-fill{height:100%;border-radius:6px;display:flex;align-items:center;padding-right:9px;font-size:11px;font-weight:700;color:#07090f}
.rr-verdict{margin-top:14px;padding:13px 16px;border-radius:9px;font-size:13px;line-height:1.7}
.rr-verdict.green{background:rgba(46,204,113,.08);border:1px solid rgba(46,204,113,.3)}.rr-verdict.green b{color:var(--green)}
.rr-verdict.red{background:rgba(224,92,92,.08);border:1px solid rgba(224,92,92,.3)}.rr-verdict.red b{color:var(--red)}
.cashbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:var(--surface);border:1px solid var(--border2);border-radius:10px;padding:13px 16px;margin-bottom:14px}
.cashbar label{font-size:12.5px;color:var(--muted2)}
.cashbar input{background:var(--bg);border:1px solid var(--border2);border-radius:7px;color:var(--text);font-size:15px;font-weight:800;padding:8px 12px;width:130px;font-family:inherit}
.cashbar input:focus{outline:none;border-color:var(--orange)}
.cashbar .hint{font-size:11px;color:var(--muted)}
.ptable{width:100%;border-collapse:collapse;margin-top:6px}
.ptable th{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;text-align:right;padding:9px 8px;border-bottom:1px solid var(--border)}
.ptable td{padding:11px 8px;border-bottom:1px solid var(--bg);font-size:12.5px;font-variant-numeric:tabular-nums;vertical-align:top}
.ptag{display:inline-block;width:11px;height:11px;border-radius:3px;margin-left:5px;vertical-align:middle}
.ptable .why{color:var(--muted2);font-size:11px;line-height:1.55;font-variant-numeric:normal}
</style>
</head>
<body>
<div id="root" class="error-box">⏳ טוען…</div>
<script>
'use strict';
const params=new URLSearchParams(location.search);const ticker=params.get('ticker');
if(!ticker){document.getElementById('root').innerHTML='<b>שגיאה:</b> חסר טיקר.';}
else{document.title='Executor — '+ticker;const s=document.createElement('script');s.src='../analyses/'+ticker+'/executor.js';s.onload=init;s.onerror=()=>{document.getElementById('root').innerHTML='<b>אין נתונים</b> ל-'+ticker;};document.head.appendChild(s);}

var TF={yearly:{interval:'1mo',range:'max',label:'שנתי · נר חודשי · היסטוריה מלאה'},monthly:{interval:'1wk',range:'5y',label:'חודשי · נר שבועי · 5 שנים'},weekly:{interval:'1d',range:'2y',label:'שבועי · נר יומי · שנתיים'},daily:{interval:'1d',range:'6mo',label:'יומי · נר יומי · 6 חודשים'},hourly:{interval:'60m',range:'1mo',label:'שעתי · נר שעתי · חודש'}};
var DATA={},active='weekly';
var IND={ma20:true,ma50:true,ma100:false,ma200:true,volume:true,rsi:true};
var PLAN={sr:true,t1:true,t2:true,t3:true,stop:true,tp1:true,tp2:true};
var tradeCash=100;var LV={};var WHY={};var SR=[];

function sma(a,p){var o=new Array(a.length).fill(null),s=0,i;for(i=0;i<a.length;i++){s+=a[i];if(i>=p)s-=a[i-p];if(i>=p-1)o[i]=s/p;}return o;}
function rsi(a,p){var o=new Array(a.length).fill(null);if(a.length<=p)return o;var g=0,l=0,i,dd;for(i=1;i<=p;i++){dd=a[i]-a[i-1];if(dd>=0)g+=dd;else l-=dd;}g/=p;l/=p;o[p]=100-100/(1+(l===0?100:g/l));for(i=p+1;i<a.length;i++){dd=a[i]-a[i-1];g=(g*(p-1)+(dd>0?dd:0))/p;l=(l*(p-1)+(dd<0?-dd:0))/p;o[i]=100-100/(1+(l===0?100:g/l));}return o;}

async function fetchTF(tf){var c=TF[tf];var path='v8/finance/chart/'+ticker+'?interval='+c.interval+'&range='+c.range;var urls=['http://localhost:5000/api/chart?symbol='+ticker+'&interval='+c.interval+'&range='+c.range,'https://query1.finance.yahoo.com/'+path,'https://query2.finance.yahoo.com/'+path,'https://corsproxy.io/?'+encodeURIComponent('https://query1.finance.yahoo.com/'+path)];for(var j=0;j<urls.length;j++){try{var r=await fetch(urls[j],{cache:'no-store'});if(!r.ok)continue;var dt=await r.json();var res=dt.chart.result[0];var ts=res.timestamp||[];var q=res.indicators.quote[0];var rows=[],i;for(i=0;i<ts.length;i++){if(q.close[i]==null||q.open[i]==null||q.high[i]==null||q.low[i]==null)continue;rows.push([ts[i],q.open[i],q.high[i],q.low[i],q.close[i],q.volume[i]||0]);}if(rows.length>2)return rows;}catch(e){}}return null;}

function draw(){var cv=document.getElementById('chartCanvas');var candles=DATA[active];if(!candles)return;
var dpr=window.devicePixelRatio||1,W=cv.clientWidth||1000,H=520;cv.width=W*dpr;cv.height=H*dpr;var ctx=cv.getContext('2d');ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,W,H);
var padL=8,padR=66,padT=12,axisH=18,gap=12;var subs=[];if(IND.volume)subs.push('vol');if(IND.rsi)subs.push('rsi');var subH=subs.length?72:0;var priceH=H-padT-axisH-subs.length*(subH+gap);var volTop=padT+priceH+gap,rsiTop=volTop+(IND.volume?subH+gap:0);
var plotW=W-padL-padR,n=candles.length;var closes=candles.map(c=>c[4]);var i,c,hi=-1e18,lo=1e18;for(i=0;i<n;i++){if(candles[i][2]>hi)hi=candles[i][2];if(candles[i][3]<lo)lo=candles[i][3];}
var planKeys=['t1','t2','t3','stop','tp1','tp2'];planKeys.forEach(k=>{if(PLAN[k]&&LV[k]){var p=LV[k].price;if(p>hi)hi=p;if(p<lo)lo=p;}});if(PLAN.sr)SR.forEach(s=>{if(s.p>hi)hi=s.p;if(s.p<lo)lo=s.p;});
var rg=(hi-lo)||1;hi+=rg*0.05;lo-=rg*0.05;var cx=idx=>padL+(idx+0.5)*plotW/n;var py=p=>padT+(hi-p)/(hi-lo)*priceH;var cw=Math.max(1.2,(plotW/n)*0.68);
ctx.font='10px Segoe UI';ctx.textBaseline='middle';for(i=0;i<=4;i++){var pp=lo+(hi-lo)*i/4,yy=py(pp);ctx.strokeStyle='rgba(255,255,255,0.05)';ctx.beginPath();ctx.moveTo(padL,yy);ctx.lineTo(padL+plotW,yy);ctx.stroke();ctx.fillStyle='#6b7e9a';ctx.textAlign='left';ctx.fillText('$'+pp.toFixed(0),padL+plotW+6,yy);}
for(i=0;i<n;i++){c=candles[i];var up=c[4]>=c[1],col=up?'#2ecc71':'#e05c5c';ctx.strokeStyle=col;ctx.fillStyle=col;ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(cx(i),py(c[2]));ctx.lineTo(cx(i),py(c[3]));ctx.stroke();var yo=py(c[1]),yc=py(c[4]);ctx.fillRect(cx(i)-cw/2,Math.min(yo,yc),cw,Math.max(1,Math.abs(yc-yo)));}
function mline(arr,color){ctx.strokeStyle=color;ctx.lineWidth=1.5;ctx.beginPath();var st=false,k;for(k=0;k<n;k++){if(arr[k]==null)continue;var x=cx(k),y=py(arr[k]);if(!st){ctx.moveTo(x,y);st=true;}else ctx.lineTo(x,y);}ctx.stroke();}
if(IND.ma20)mline(sma(closes,20),'#4da6ff');if(IND.ma50)mline(sma(closes,50),'#f0a050');if(IND.ma100)mline(sma(closes,100),'#a78bfa');if(IND.ma200)mline(sma(closes,200),'#d4af37');
function pline(price,color,dash,label){if(price>hi||price<lo)return;var y=py(price);ctx.strokeStyle=color;ctx.lineWidth=1.5;ctx.setLineDash(dash?[6,4]:[]);ctx.beginPath();ctx.moveTo(padL,y);ctx.lineTo(padL+plotW,y);ctx.stroke();ctx.setLineDash([]);ctx.font='9.5px Segoe UI';var tw=ctx.measureText(label).width+12;ctx.fillStyle=color;ctx.fillRect(padL+3,y-8,tw,16);ctx.fillStyle='#07090f';ctx.textAlign='left';ctx.fillText(label,padL+9,y+1);}
if(PLAN.sr)SR.forEach(s=>pline(s.p,'#6b7e9a',true,s.l));
planKeys.forEach(k=>{if(!PLAN[k]||!LV[k])return;var L=LV[k],lab;if(k[0]==='t'&&k!=='tp1'&&k!=='tp2'){var amt=Math.round(tradeCash*L.pct/100);var sh=(amt/L.price).toFixed(2);lab=L.name+' · $'+L.price+' · '+L.pct+'% ($'+amt+' ≈ '+sh+' מ\')';pline(L.price,L.color,false,lab);}else if(k==='stop'){pline(L.price,L.color,true,'🛑 '+L.name+' · $'+L.price);}else{pline(L.price,L.color,true,'🎯 '+L.name+' · $'+L.price);}});
if(IND.volume){var vmax=0;for(i=0;i<n;i++)if(candles[i][5]>vmax)vmax=candles[i][5];vmax=vmax||1;ctx.fillStyle='#8899aa';ctx.textAlign='left';ctx.font='9px Segoe UI';ctx.fillText('ווליום',padL+4,volTop+8);for(i=0;i<n;i++){c=candles[i];var u=c[4]>=c[1],vh=(c[5]/vmax)*subH;ctx.fillStyle=u?'rgba(46,204,113,0.42)':'rgba(224,92,92,0.42)';ctx.fillRect(cx(i)-cw/2,volTop+subH-vh,cw,vh);}}
if(IND.rsi){var rs=rsi(closes,14);[30,50,70].forEach(lv=>{var y=rsiTop+subH-(lv/100)*subH;ctx.strokeStyle=lv===50?'rgba(255,255,255,0.05)':'rgba(245,200,66,0.14)';ctx.beginPath();ctx.moveTo(padL,y);ctx.lineTo(padL+plotW,y);ctx.stroke();ctx.fillStyle='#6b7e9a';ctx.textAlign='left';ctx.fillText(String(lv),padL+plotW+6,y);});ctx.strokeStyle='#a78bfa';ctx.lineWidth=1.5;ctx.beginPath();var st2=false;for(i=0;i<n;i++){if(rs[i]==null)continue;var ry=rsiTop+subH-(Math.max(0,Math.min(100,rs[i]))/100)*subH;if(!st2){ctx.moveTo(cx(i),ry);st2=true;}else ctx.lineTo(cx(i),ry);}ctx.stroke();ctx.fillStyle='#8899aa';ctx.textAlign='left';ctx.font='9px Segoe UI';ctx.fillText('RSI(14)',padL+4,rsiTop+8);}
ctx.fillStyle='#6b7e9a';ctx.textAlign='center';ctx.font='9.5px Segoe UI';var step=Math.max(1,Math.floor(n/7));for(i=0;i<n;i+=step){var dt2=new Date(candles[i][0]*1000);ctx.fillText((dt2.getMonth()+1)+'/'+String(dt2.getFullYear()).slice(2),cx(i),H-6);}
var last=candles[n-1];document.getElementById('chartMeta').textContent=TF[active].label+' · '+n+' נרות · אחרון $'+last[4].toFixed(2);}

function renderPlan(d){var body=document.getElementById('planBody');var keys=['t1','t2','t3'],html='',totSh=0,totCost=0;
keys.forEach(k=>{var L=LV[k];if(!L)return;var amt=tradeCash*L.pct/100,sh=amt/L.price;totSh+=sh;totCost+=amt;
var up=(d.fair_value-L.price)/L.price*100,dn=(L.price-d.bear_price)/L.price*100,rr=(up/dn).toFixed(1);
html+='<tr><td><span class="ptag" style="background:'+L.color+'"></span>'+L.name+'</td><td><b>$'+L.price+'</b></td><td>'+L.pct+'%</td><td>$'+Math.round(amt)+'</td><td>'+sh.toFixed(2)+'</td><td style="color:'+(rr>=2?'#2ecc71':'#f5c842')+';font-weight:700">'+rr+':1</td><td class="why">'+WHY[k]+'</td></tr>';});
body.innerHTML=html;var avg=totSh>0?totCost/totSh:0;document.getElementById('avgEntry').textContent='$'+avg.toFixed(2)+'  ('+totSh.toFixed(2)+' מניות · $'+Math.round(totCost)+')';}

function setStatus(m){var s=document.getElementById('chartStatus');if(m===null)s.classList.add('hidden');else{s.classList.remove('hidden');s.innerHTML=m;}}

function bindToggles(d){document.querySelectorAll('[data-ind]').forEach(b=>b.addEventListener('click',()=>{var k=b.dataset.ind;IND[k]=!IND[k];b.classList.toggle('on',IND[k]);draw();}));document.querySelectorAll('[data-plan]').forEach(b=>b.addEventListener('click',()=>{var k=b.dataset.plan;PLAN[k]=!PLAN[k];b.classList.toggle('on',PLAN[k]);draw();}));document.querySelectorAll('.tftab').forEach(t=>t.addEventListener('click',()=>{document.querySelectorAll('.tftab').forEach(x=>x.classList.remove('active'));t.classList.add('active');active=t.dataset.tf;if(DATA[active]){setStatus(null);draw();}else setStatus('⚠️ הטווח לא נטען. רענן (F5).');}));document.getElementById('cashInput').addEventListener('input',function(){var v=parseFloat(this.value);tradeCash=(isNaN(v)||v<0)?0:v;renderPlan(d);draw();});}

async function init(){const d=window.AGENT_DATA;if(!d)return;
LV=d.plan.levels;WHY=d.plan.rationale;SR=d.plan.support_resistance||[];tradeCash=d.plan.cash||100;
const root=document.getElementById('root');root.className='';
root.innerHTML=`
<div class="topbar tb-orange">
  <div><h1 class="c-orange">🎯 Executor — ${d.company||d.ticker}</h1><div class="sub">קצין ביצוע · תזמון ומבנה כניסה</div></div>
  <div class="stamp">תאריך: <b>${d.date}</b><br>חוליה 4 בשרשרת</div>
</div>
<div class="wrap">
  ${d.inherited?`<div class="inherit">
    <div class="ih-title">① אימות קלטים</div>
    ${d.inherited.map(i=>`<div class="ih-r"><span>${i.icon}</span><span class="tx">${i.text}</span></div>`).join('')}
  </div>`:''}

  <div class="section">
    <h2><span class="bar-accent" style="background:var(--blue)"></span>② תמונה טכנית — גרפים חיים</h2>
    <div class="servernote"><b>📡 הגרפים נטענים דרך שרת הדשבורד.</b> ודא ש-serve.ps1 רץ על localhost:5000.</div>
    <div class="indstrip">${d.technical_cards.map(c=>`<div class="indchip"><div class="ic-l">${c.lbl}</div><div class="ic-v ${c.color||'c-text'}" ${c.id?`id="${c.id}"`:''}>${c.val}</div><div class="ic-s">${c.sub||''}</div></div>`).join('')}</div>
    <div class="tftabs">
      <button class="tftab" data-tf="yearly">שנתי</button>
      <button class="tftab" data-tf="monthly">חודשי</button>
      <button class="tftab active" data-tf="weekly">שבועי</button>
      <button class="tftab" data-tf="daily">יומי</button>
      <button class="tftab" data-tf="hourly">שעתי</button>
    </div>
    <div class="toggrow">
      <div class="toggroup"><span class="gl">אינדיקטורים</span>
        <button class="tg c-ma20 on" data-ind="ma20"><span class="dotc" style="background:var(--blue)"></span>MA20</button>
        <button class="tg c-ma50 on" data-ind="ma50"><span class="dotc" style="background:var(--orange)"></span>MA50</button>
        <button class="tg c-ma100" data-ind="ma100"><span class="dotc" style="background:var(--purple)"></span>MA100</button>
        <button class="tg c-ma200 on" data-ind="ma200"><span class="dotc" style="background:var(--gold)"></span>MA200</button>
        <button class="tg c-vol on" data-ind="volume">ווליום</button>
        <button class="tg c-rsi on" data-ind="rsi">RSI</button>
      </div>
      <div class="toggroup"><span class="gl">תוכנית מסחר</span>
        <button class="tg c-sr on" data-plan="sr">S/R</button>
        <button class="tg c-e on" data-plan="t1">כניסה 1</button>
        <button class="tg c-eg on" data-plan="t2">כניסה 2</button>
        <button class="tg c-eg on" data-plan="t3">כניסה 3</button>
        <button class="tg c-stop on" data-plan="stop">סטופ</button>
        <button class="tg c-tp on" data-plan="tp1">TP1</button>
        <button class="tg c-tp on" data-plan="tp2">TP2</button>
      </div>
    </div>
    <div class="chartbox"><canvas id="chartCanvas"></canvas><div class="chart-status" id="chartStatus">⏳ טוען…</div></div>
    <div class="chartmeta" id="chartMeta"></div>
  </div>

  ${d.filters?`<div class="section">
    <h2><span class="bar-accent" style="background:var(--green)"></span>③ פילטרים קשיחים</h2>
    <div class="desc">${d.filters.description||''}</div>
    <div class="ftiles">${d.filters.tiles.map(t=>`<div class="ftile ${t.warn?'warn':''}"><div class="ft-head"><div class="ft-ico">${t.icon}</div><div class="ft-name">${t.name}</div><div class="ft-badge">${t.badge}</div></div><div class="ft-val">${t.val}</div><div class="ft-detail">${t.detail}</div></div>`).join('')}</div>
  </div>`:''}

  ${d.rr?`<div class="section">
    <h2><span class="bar-accent" style="background:var(--green)"></span>④ סיכון / תשואה</h2>
    <div class="desc">${d.rr.description||''}</div>
    <div class="rrbox">${d.rr.bars.map(b=>`<div class="rrrow"><div class="rr-lbl"><span>${b.label}</span><span class="v ${b.color}">${b.pct}</span></div><div class="rr-track"><div class="rr-fill" style="width:${b.width}%;background:var(--${b.bg})">${b.dollar}</div></div></div>`).join('')}
    <div class="rr-verdict ${d.rr.verdict.style}"><b>${d.rr.verdict.headline}</b> ${d.rr.verdict.body}</div></div>
  </div>`:''}

  ${d.verdict?`<div class="verdict ${d.verdict.style||'green'}">
    <span class="tag">⑤ פסיקת מבצע</span>
    <h2>${d.verdict.headline}</h2>
    ${d.verdict.paragraphs.map(p=>`<p>${p}</p>`).join('')}
    <div class="scorebig">${d.verdict.scoreboxes.map(s=>`<div class="scorebox"><div class="sb-lbl">${s.lbl}</div><div class="sb-num ${s.color}" style="font-size:${s.size||'20'}px">${s.val}</div></div>`).join('')}</div>
  </div>`:''}

  <div class="section">
    <h2><span class="bar-accent" style="background:var(--orange)"></span>⑥ תוכנית ביצוע — Scale In</h2>
    <div class="desc">${d.plan.description||''}</div>
    <div class="cashbar"><label>💵 סכום מתוכנן:</label><span style="color:var(--muted2);font-weight:800">$</span>
      <input id="cashInput" type="number" min="0" step="10" value="${d.plan.cash}">
      <span class="hint">${d.plan.cash_hint||''}</span></div>
    <table class="ptable"><thead><tr><th>יעד</th><th>מחיר</th><th>חלק</th><th>סכום $</th><th>~מניות</th><th>R/R</th><th>הנימוק</th></tr></thead>
    <tbody id="planBody"></tbody></table>
    <div class="desc" style="margin-top:14px;margin-bottom:0">
      <b>כניסה ממוצעת:</b> <span id="avgEntry" style="color:var(--text)">—</span> ·
      <b>סטופ:</b> <span class="c-red">$${LV.stop?LV.stop.price:'—'}</span> ·
      <b>יעדי רווח:</b> <span class="c-blue">$${LV.tp1?LV.tp1.price:'—'}</span> / <span class="c-purple">$${LV.tp2?LV.tp2.price:'—'}</span>
    </div>
  </div>

  ${d.handoff?`<div class="section"><div class="handoff"><b>📤 HANDOFF לוועדת ההשקעות</b><br>${d.handoff}</div></div>`:''}
</div>
<div class="footer">${d.footer||''}</div>`;

bindToggles(d);renderPlan(d);setStatus('⏳ טוען נתוני שוק חיים…');
var names=Object.keys(TF);var results=await Promise.allSettled(names.map(fetchTF));results.forEach((r,i)=>{if(r.status==='fulfilled'&&r.value)DATA[names[i]]=r.value;});
if(DATA[active]){setStatus(null);draw();var lp=DATA[active][DATA[active].length-1][4];var priceEl=document.getElementById('ind-price');if(priceEl)priceEl.textContent='$'+lp.toFixed(2);}
else if(Object.keys(DATA).length){active=Object.keys(DATA)[0];document.querySelectorAll('.tftab').forEach(x=>x.classList.toggle('active',x.dataset.tf===active));setStatus(null);draw();}
else{setStatus('⚠️ <b>לא ניתן לטעון.</b><br>ודא ששרת הדשבורד רץ. רענן (F5).');}
var rt;window.addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(()=>{if(DATA[active])draw();},200);});}
</script>
</body>
</html>
